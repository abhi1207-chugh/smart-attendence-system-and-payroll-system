# PostgreSQL (Docker) — copy to .env and set real values locally
POSTGRES_DB=smart_attendance
POSTGRES_USER=smart_attendance_app
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432

# Connection URL for migrations (dbmate) and backend use
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=postgres://smart_attendance_app:change_me_in_local_env@localhost:5432/smart_attendance?sslmode=disable

# Backend API (Phase 2.3+)
BACKEND_PORT=3001
NODE_ENV=development
